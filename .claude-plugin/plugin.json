{
  "name": "slop-obliterator",
  "version": "0.2.0",
  "description": "Kills AI-slop output across UI, prose, and code with deterministic rendered audits, structural design planning, craft profiles, component/icon retrieval, and bounded Figma + Playwright evidence workflows.",
  "author": {
    "name": "Josiah Davis"
  },
  "license": "MIT",
  "keywords": [
    "ui",
    "ux",
    "design",
    "design-system",
    "accessibility",
    "playwright",
    "figma",
    "anti-slop",
    "code-quality",
    "writing"
  ],
  "mcpServers": {
    "slop-obliterator": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/dist/index.js"
      ],
      "env": {
        "SLOP_ARTIFACT_DIR": "${CLAUDE_PLUGIN_ROOT}/.artifacts"
      }
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--isolated"
      ]
    }
  }
}
