{
  "name": "@slop-obliterator/server",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server: browser-backed design auditing, OKLCH token generation, offline icon and component search.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare:browser": "playwright install chromium",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "node dist/selftest.js && node dist/sources/components.selftest.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tabler/icons": "^3.46.0",
    "culori": "^4.0.2",
    "lucide-static": "^1.37.0",
    "playwright": "^1.62.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
