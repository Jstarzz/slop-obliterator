# Normalise line endings so a Windows checkout doesn't churn the whole tree.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.woff2 binary

# Keep generated noise out of diffs and language stats.
server/package-lock.json linguist-generated=true -diff
